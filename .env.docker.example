NODE_ENV=development
SERVICE=tracking
PORT=3004
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgresql://tracking_app.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
MIGRATION_DATABASE_URL=postgresql://tracking_migrator.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DB_SSL_ENABLED=true
DB_SSL_CA_PATH=/app/certs/supabase-ca.crt
DB_POOL_MAX=5
JWT_PUBLIC_KEY_PATH=/app/keys/auth-public.pem
JWT_ISSUER=restaurant-auth
JWT_AUDIENCE=restaurant-api
RABBITMQ_URL=amqps://USER:PASSWORD@HOST:5671/VHOST
CONSUMER_ENABLED=true
MQ_QUEUE=tracking.lifecycle.q
MQ_DLQ=tracking.lifecycle.q.dlq
MQ_PREFETCH=20
DELIVERY_WORKER_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TableBooking <sender@example.test>

DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
MQ_MAX_RETRIES=3
MQ_RETRY_DELAYS_MS=5000,30000,120000
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BACKOFF_MS=30000,120000,600000,1800000
DELIVERY_BATCH_SIZE=20
DELIVERY_POLL_INTERVAL_MS=1000
DELIVERY_LEASE_MS=60000
SMTP_TIMEOUT_MS=10000
