# Chay lan dau: node --env-file=.env.bootstrap scripts/bootstrap.mjs
# Khong commit mat khau that. Role da ton tai khong tu doi password.

# DIEN password quan tri DB Supabase (URL-encode chi phan password).
BOOTSTRAP_DATABASE_URL=postgresql://postgres.vpkybfpwxerhzxgvghna:YOUR_ADMIN_PASSWORD_ENCODED@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Password tu tao cho hai role Tracking, nguyen ban (khong encode o day).
APP_DB_PASSWORD=REPLACE_ME
MIGRATOR_DB_PASSWORD=REPLACE_ME

# Tai CA certificate cua project Tracking vao duong dan nay.
DB_SSL_ENABLED=true
DB_SSL_CA_PATH=./certs/supabase-ca.crt
