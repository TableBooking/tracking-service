{
  "name": "tablebooking-tracking-service",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API gateway for the TableBooking platform",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/config.test.js .test-dist/test/event.test.js",
    "migrate": "node dist/migrate.js",
    "bootstrap": "node scripts/bootstrap.mjs",
    "test:integration": "tsc -p tsconfig.test.json && node --test .test-dist/test/integration.test.js",
    "test:gateway": "node scripts/test-gateway.mjs",
    "diagnostics": "node scripts/diagnostics.mjs",
    "publish:fixture": "node scripts/publish-fixture.mjs",
    "provision:broker": "node scripts/provision-broker.mjs",
    "test:broker": "node scripts/test-broker.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/config": "12.1.0",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "amqplib": "0.10.9",
    "helmet": "8.3.0",
    "jose": "6.2.15",
    "nestjs-pino": "5.3.1",
    "pg": "8.16.3",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.11",
    "@types/amqplib": "0.10.8",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
