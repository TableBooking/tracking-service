# Tracking - chay rieng, Supabase project vpkybfpwxerhzxgvghna
NODE_ENV=development
PORT=3004

# Supabase Session pooler IPv4, port 5432; password trong URL da encode.
DATABASE_URL=postgresql://tracking_app.vpkybfpwxerhzxgvghna:YOUR_APP_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Chi dung de migrate, khong dung tai khoan postgres cho runtime.
MIGRATION_DATABASE_URL=postgresql://tracking_migrator.vpkybfpwxerhzxgvghna:YOUR_MIGRATOR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_SSL_ENABLED=true
DB_SSL_CA_PATH=./certs/supabase-ca.crt

# Public key chung cua Auth; khong dung private key.
JWT_PUBLIC_KEY_PATH=./keys/auth-public.pem
JWT_ISSUER=restaurant-auth
JWT_AUDIENCE=restaurant-api

# Dung broker Docker da cau hinh cho Notification, queue Tracking rieng.
# Node: localhost:5675; Docker: rabbitmq:5672 trong network chung.
RABBITMQ_URL=amqp://notification_dev:YOUR_RABBITMQ_PASSWORD@localhost:5675
# Docker Compose: broker cua Notification trong network tablebooking-user3.
RABBITMQ_DOCKER_URL=amqp://notification_dev:YOUR_RABBITMQ_PASSWORD@rabbitmq:5672

# Queue tracking.lifecycle.q, retry/timeout dung mac dinh trong code.
# Tracking khong gui email, khong can SMTP/Mailpit env.
